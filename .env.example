# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais

# MolGpKa API Token (obtenha em: http://xundrug.cn:5001/)
MOLGPKA_TOKEN=your_molgpka_token_here

# zkVerify Network Configuration
ZKVERIFY_ENDPOINT=wss://testnet-rpc.zkverify.io

# Wallet Configuration (para scripts de submissão automática)
# CUIDADO: Nunca compartilhe sua seed phrase real!
ZKVERIFY_SEED_PHRASE=your_test_wallet_seed_phrase_here
TALISMAN_SEED_PHRASE=your_talisman_wallet_seed_phrase_here
ZK_TESTNET_MNEMONIC=your_testnet_mnemonic_here

# AutoDock Vina Path (opcional, se disponível)
VINA_PATH=/usr/local/bin/vina

# GROMACS Path (opcional, se disponível) 
GROMACS_PATH=/usr/local/gromacs/bin

# API Keys para serviços externos (se necessário)
# RDKIT_LICENSE_KEY=your_rdkit_license_if_required
